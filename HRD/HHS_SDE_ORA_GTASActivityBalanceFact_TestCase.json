      "datasetName": "JDBC_2",
      "query": "WITH SRC AS (SELECT CCID, PERIOD_NUM, SET_OF_BOOKS_ID, PERIOD_YEAR, JE_SOURCE, JE_CATEGORY, FUND_VALUE, ACCOUNT_NUMBER, AUTHORITY_TYPE_CODE, FED_NON_FED, TRADING_PARTNER_TYPE, TRADING_PARTNER_NAME, TRADING_PARTNER_AGENCY_ID, TRADING_PARTNER_MAIN_ACCOUNT, BUDGET_IMPACT_IND, D_C_INDICATOR, AMOUNT, JE_HEADER_ID, JE_LINE_NUM, RECORD_CATEGORY, GL_PERIOD, BALANCE_TYPE, TRADING_PARTNER_ID, PERIOD_NAME, EXCEPTION_CATEGORY, DOLLAR_AMOUNT, REDUCTION_TYPE_CODE, DACT_REPORT_IND, PIID, PARENT_AWARD_ID, FAIN, URI, DOC_NUM, POSTED_DATE, DEFAULT_EFFECTIVE_DATE, AE_HEADER_ID, AE_LINE_NUM, CREATION_DATE, EVENT_ID, PARENT_AWARD_ID AS PROVIDER_RECIPNT_ID FROM FV_GTAS_ACTIVITY_BALANCES WHERE CREATION_DATE >= TO_DATE('$$LAST_EXTRACT_DATE', 'MM/DD/YYYY HH24:MI:SS')), LKP_PROVD_RECP AS (SELECT DISTINCT FLEX_VALUE, DESCRIPTION FROM FND_FLEX_VALUES_VL WHERE VALUE_CATEGORY = 'HHS_TP_ELIMINATION_CODE') SELECT SRC.CCID, SRC.PERIOD_NUM, SRC.SET_OF_BOOKS_ID, SRC.PERIOD_YEAR, SRC.JE_SOURCE, SRC.JE_CATEGORY, SRC.FUND_VALUE, SRC.ACCOUNT_NUMBER, SRC.AUTHORITY_TYPE_CODE, SRC.FED_NON_FED, SRC.TRADING_PARTNER_TYPE, SRC.TRADING_PARTNER_NAME, SRC.TRADING_PARTNER_AGENCY_ID, SRC.TRADING_PARTNER_MAIN_ACCOUNT, SRC.BUDGET_IMPACT_IND, SRC.D_C_INDICATOR, SRC.AMOUNT, SRC.JE_HEADER_ID, SRC.JE_LINE_NUM, SRC.RECORD_CATEGORY, SRC.GL_PERIOD, SRC.BALANCE_TYPE, SRC.TRADING_PARTNER_ID, SRC.PERIOD_NAME, SRC.EXCEPTION_CATEGORY, SRC.DOLLAR_AMOUNT, SRC.REDUCTION_TYPE_CODE, SRC.DACT_REPORT_IND, SRC.PIID, SRC.PARENT_AWARD_ID, SRC.FAIN, SRC.URI, SRC.DOC_NUM, SRC.POSTED_DATE, SRC.DEFAULT_EFFECTIVE_DATE, SRC.AE_HEADER_ID, SRC.AE_LINE_NUM, CAST(NULL AS VARCHAR(100)) AS INTEGRATION_ID, SRC.CREATION_DATE AS CREATED_ON_DT, CAST(NULL AS NUMBER) AS DATASOURCE_NUM_ID, SRC.PROVIDER_RECIPNT_ID, CASE WHEN LENGTH(SRC.PROVIDER_RECIPNT_ID) = 7 AND SUBSTR(SRC.PROVIDER_RECIPNT_ID,1,3) != '075' THEN (SELECT L.DESCRIPTION FROM LKP_PROVD_RECP L WHERE L.FLEX_VALUE = SUBSTR(SRC.PROVIDER_RECIPNT_ID,2,2)) WHEN SUBSTR(SRC.PROVIDER_RECIPNT_ID,1,3) = '075' THEN (SELECT I.DESCRIPTION FROM W_GTAS_INTRAHHS_D I WHERE I.TP_MAIN_ACT = SUBSTR(SRC.PROVIDER_RECIPNT_ID,4,4)) ELSE (SELECT L.DESCRIPTION FROM LKP_PROVD_RECP L WHERE L.FLEX_VALUE = SRC.PROVIDER_RECIPNT_ID) END AS PROVIDER_RECIPNT_NAME, SRC.EVENT_ID FROM SRC",
      "dependencies": [],
