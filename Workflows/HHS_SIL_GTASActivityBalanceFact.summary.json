\n\r\nLEFT OUTER JOIN W_GL_ACCOUNT_D ON \r\n  W_GTAS_ACTIVITY_BALANCES_FS.CCID = W_GL_ACCOUNT_D.INTEGRATION_ID AND\r\n  W_GTAS_ACTIVITY_BALANCES_FS.DATASOURCE_NUM_ID = W_GL_ACCOUNT_D.DATASOURCE_NUM_ID AND\r\n  W_GL_ACCOUNT_D.CURRENT_FLG = 'Y'\r\n\r\nLEFT OUTER JOIN W_FV_TP_TREASURY_SYMBOLS_D ON \r\nW_GTAS_ACTIVITY_BALANCES_FS.TRADING_PARTNER_ID = W_FV_TP_TREASURY_SYMBOLS_D.INTEGRATION_ID AND\r\nW_GTAS_ACTIVITY_BALANCES_FS.DATASOURCE_NUM_ID = W_FV_TP_TREASURY_SYMBOLS_D.INTEGRATION_ID AND \r\nW_FV_TP_TREASURY_SYMBOLS_D.CURRENT_FLG = \u2018Y\u2019\r\n\r\n  \r\nLEFT OUTER JOIN W_LEDGER_D ON \r\n  W_GTAS_ACTIVITY_BALANCES_FS.SET_OF_BOOKS_ID = W_LEDGER_D.INTEGRATION_ID AND\r\n  W_GTAS_ACTIVITY_BALANCES_FS.DATASOURCE_NUM_ID = W_LEDGER_D.DATASOURCE_NUM_ID \r\n  \r\nLEFT OUTER JOIN W_MCAL_PERIOD_D ON \r\n  W_GTAS_ACTIVITY_BALANCES_FS.PERIOD_YEAR = W_MCAL_PERIOD_D.MCAL_PERIOD AND\r\n  W_GTAS_ACTIVITY_BALANCES_FS.PERIOD_NUM = W_MCAL_PERIOD_D.MCAL_YEAR AND\r\n  W_GTAS_ACTIVITY_BALANCES_FS.DATASOURCE_NUM_ID = W_MCAL_PERIOD_D.DATASOURCE_NUM_ID \r\n  \r\nLEFT OUTER JOIN W_MCAL_DAY_D ON \r\n  W_GTAS_ACTIVITY_BALANCES_FS.POSTED_DATE = W_MCAL_DAY_D.INTEGRATION_ID AND\r\n  W_GTAS_ACTIVITY_BALANCES_FS.DATASOURCE_NUM_ID = W_MCAL_DAY_D.DATASOURCE_NUM_ID \r\n  \r\nLEFT OUTER JOIN W_GL_JE_SOURCES_D ON \r\n  W_GTAS_ACTIVITY_BALANCES_FS.JE_SOURCE = W_GL_JE_SOURCES_D.INTEGRATION_ID \r\n  \r\nLEFT OUTER JOIN W_GL_JE_CATEGORIES_D ON \r\n  W_GTAS_ACTIVITY_BALANCES_FS.JE_CATEGORY = W_GL_JE_CATEGORIES_D.INTEGRATION_ID"
