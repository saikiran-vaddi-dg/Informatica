        "Sql Query": "SELECT \r\n  CEBV_BANK_ACCOUNTS.BANK_ACCOUNT_ID,\r\n  CEBV_BANK_ACCOUNTS.LAST_UPDATE_DATE,\r\n  CEBV_BANK_ACCOUNTS.LAST_UPDATED_BY,\r\n  CEBV_BANK_ACCOUNTS.CREATION_DATE,\r\n  CEBV_BANK_ACCOUNTS.CREATED_BY,\r\n  CEBV_BANK_ACCOUNTS.BANK_ACCOUNT_NUMBER,\r\n  HZ_PARTIES.PARTY_NAME,\r\n  CEBV_BANK_ACCOUNTS.BANK_ACCOUNT_TYPE,\r\n  CEBV_BANK_ACCOUNTS.ACCOUNT_TYPE,\r\n  CEBV_BANK_ACCOUNTS.BANK_ACCOUNT_NAME_ALT,\r\n  CEBV_BANK_ACCOUNTS.ACCOUNT_HOLDER_NAME,\r\n  CEBV_BANK_BRANCHES.BANK_NAME,\r\n  CEBV_BANK_BRANCHES.BANK_BRANCH_NAME,\r\n  CEBV_BANK_BRANCHES.ADDRESS_LINE1,\r\n  CEBV_BANK_BRANCHES.ADDRESS_LINE2,\r\n  CEBV_BANK_BRANCHES.ADDRESS_LINE3,\r\n  CEBV_BANK_BRANCHES.CITY,\r\n  CEBV_BANK_BRANCHES.STATE,\r\n  CEBV_BANK_BRANCHES.COUNTRY,\r\n  PARTY_REL.PRIMARY_PHONE_AREA_CODE,\r\n  PARTY_REL.PRIMARY_PHONE_NUMBER,\r\n  CEBV_BANK_BRANCHES.BANK_NUMBER,\r\n  CEBV_BANK_BRANCHES.INSTITUTION_TYPE,\r\n  CEBV_BANK_BRANCHES.BANK_NUMBER,\r\n  CEBV_BANK_BRANCHES.COUNTY,\r\n  CEBV_BANK_BRANCHES.LAST_UPDATE_DATE,\r\n  CEBV_BANK_ACCOUNTS.BANK_ACCOUNT_NAME,\r\n  CEBV_BANK_ACCOUNTS.AGENCY_LOCATION_CODE,\r\n CEBV_BANK_ACCOUNTS.PRIMARY_FLAG,\r\nCEBV_BANK_ACCOUNTS.END_DATE\r\nFROM \r\n  (SELECT  bankorgprofile.organization_name bank_name,\r\n               bankorgprofile.bank_or_branch_number bank_number,\r\n               branchparty.party_id bank_branch_id,\r\n               branchparty.party_name bank_branch_name,\r\n               branchparty.address1 address_line1,\r\n               branchparty.address2 address_line2,\r\n               branchparty.address3 address_line3,\r\n               branchparty.city city,\r\n               branchparty.province county,\r\n               branchparty.state state,\r\n               branchparty.country country,\r\n               bankca.class_code institution_type,\r\n               TO_DATE(NULL) last_update_date            \r\n          FROM hz_organization_profiles bankorgprofile,\r\n               hz_code_assignments      bankca,\r\n               hz_parties               branchparty,\r\n               hz_organization_profiles branchorgprofile,\r\n               hz_code_assignments      branchca,\r\n               hz_relationships         brrel\r\n         WHERE SYSDATE BETWEEN TRUNC(bankorgprofile.effective_start_date) \r\n                                                               AND  NVL(TRUNC(bankorgprofile.effective_end_date), SYSDATE + 1)\r\n           AND bankca.class_category = 'BANK_INSTITUTION_TYPE'\r\n           AND bankca.class_code IN ('BANK', 'CLEARINGHOUSE')\r\n           AND bankca.owner_table_name = 'HZ_PARTIES'\r\n           AND NVL(bankca.status, 'A') = 'A'\r\n           AND bankca.owner_table_id = bankorgprofile.party_id\r\n           AND branchparty.party_type = 'ORGANIZATION'\r\n           AND branchparty.status = 'A'\r\n           AND branchorgprofile.party_id = branchparty.party_id\r\n           AND SYSDATE BETWEEN TRUNC(branchorgprofile.effective_start_date)\r\n                                                        AND   NVL(TRUNC(branchorgprofile.effective_end_date), SYSDATE + 1)\r\n           AND branchca.class_category = 'BANK_INSTITUTION_TYPE'\r\n           AND branchca.class_code IN ('BANK_BRANCH', 'CLEARINGHOUSE_BRANCH')\r\n           AND branchca.owner_table_name = 'HZ_PARTIES'\r\n           AND NVL(branchca.status, 'A') = 'A'\r\n           AND branchca.owner_table_id = branchparty.party_id\r\n           AND bankorgprofile.party_id = brrel.object_id\r\n           AND brrel.relationship_type = 'BANK_AND_BRANCH'\r\n           AND brrel.relationship_code = 'BRANCH_OF'\r\n           AND brrel.status = 'A'\r\n           AND brrel.subject_table_name = 'HZ_PARTIES'\r\n           AND brrel.subject_type = 'ORGANIZATION'\r\n           AND brrel.object_table_name = 'HZ_PARTIES'\r\n           AND brrel.object_type = 'ORGANIZATION'\r\n           AND brrel.subject_id = branchparty.party_id\r\n  ) CEBV_BANK_BRANCHES,\r\n  ( SELECT ACC.BANK_ACCOUNT_ID bank_account_id,\r\n       ACC.BANK_ACCOUNT_NAME_ALT bank_account_name_alt,\r\n       ACC.BANK_ACCOUNT_NUM bank_account_number,\r\n       ACC.BANK_ACCOUNT_TYPE bank_account_type,\r\n       'INTERNAL'  account_type,\r\n       ACC.ACCOUNT_HOLDER_NAME account_holder_name,\r\n       ACC.BANK_BRANCH_ID bank_branch_id,\r\n       ACC.CREATION_DATE creation_date,\r\n       ACC.CREATED_BY created_by,\r\n       ACC.LAST_UPDATE_DATE last_update_date,\r\n       ACC.LAST_UPDATED_BY last_updated_by,\r\n       ACC.BANK_ACCOUNT_NAME bank_account_name,\r\n       ACC.AGENCY_LOCATION_CODE agency_location_code,\r\n       'Y' as primary_flag,\r\n       ACC.end_date end_date\r\n  FROM CE_BANK_ACCOUNTS ACC\r\nUNION ALL\r\nSELECT EB.EXT_BANK_ACCOUNT_ID bank_account_id,\r\n       EB.BANK_ACCOUNT_NAME_ALT bank_account_name_alt,\r\n       EB.masked_bank_account_num bank_account_number,\r\n       EB.BANK_ACCOUNT_TYPE bank_account_type,\r\n       'EXTERNAL' account_type,\r\n       TO_CHAR(NULL)       account_holder_name,\r\n       EB.BRANCH_ID           bank_branch_id,\r\n       EB.creation_date          creation_date,\r\n       EB.created_by               created_by,\r\n       EB.last_update_date   last_update_date,\r\n       EB.last_updated_by     last_updated_by,\r\n       EB.BANK_ACCOUNT_NAME bank_account_name,\r\n       EB.AGENCY_LOCATION_CODE agency_location_code,\r\n       ow.primary_flag primary_flag,\r\n       ow.end_date end_date\r\n   FROM \r\n                   iby_account_owners       ow,\r\n                   iby_ext_bank_accounts    EB\r\n WHERE eb.ext_bank_account_id = ow.ext_bank_account_id(+)\r\n                   AND ow.primary_flag(+) = 'Y'\r\n                  -- AND NVL(ow.end_date, SYSDATE + 10) > SYSDATE\r\n)  \r\n  CEBV_BANK_ACCOUNTS,\r\n  CE_CONTACT_ASSIGNMENTS,\r\n  HZ_RELATIONSHIPS,\r\n  HZ_PARTIES,\r\n  HZ_PARTIES PARTY_REL\r\nWHERE \r\n  CEBV_BANK_ACCOUNTS.BANK_BRANCH_ID =  CEBV_BANK_BRANCHES.BANK_BRANCH_ID  AND\r\n  CEBV_BANK_ACCOUNTS.BANK_ACCOUNT_ID = CE_CONTACT_ASSIGNMENTS.BANK_ACCOUNT_ID(+) AND\r\n  CE_CONTACT_ASSIGNMENTS.RELATIONSHIP_ID = HZ_RELATIONSHIPS.RELATIONSHIP_ID(+) AND\r\n  HZ_RELATIONSHIPS.RELATIONSHIP_CODE(+)='CONTACT_OF' AND\r\n  HZ_RELATIONSHIPS.SUBJECT_ID = HZ_PARTIES.PARTY_ID(+) AND\r\n  HZ_RELATIONSHIPS.PARTY_ID = PARTY_REL.PARTY_ID(+) AND\r\n (CEBV_BANK_ACCOUNTS.LAST_UPDATE_DATE >TO_DATE('$$LAST_EXTRACT_DATE', 'MM/DD/YYYY HH24:MI:SS')  OR   \r\n  CEBV_BANK_BRANCHES.LAST_UPDATE_DATE >TO_DATE('$$LAST_EXTRACT_DATE', 'MM/DD/YYYY HH24:MI:SS'))\r\nORDER BY CEBV_BANK_ACCOUNTS.BANK_ACCOUNT_ID",
        "User Defined Join": "CEBV_BANK_ACCOUNTS.BANK_BRANCH_ID =  CEBV_BANK_BRANCHES.BANK_BRANCH_ID  AND\r\n  CEBV_BANK_ACCOUNTS.BANK_ACCOUNT_ID = CE_CONTACT_ASSIGNMENTS.BANK_ACCOUNT_ID(+) AND\r\n  CE_CONTACT_ASSIGNMENTS.RELATIONSHIP_ID = HZ_RELATIONSHIPS.RELATIONSHIP_ID(+) AND\r\n  HZ_RELATIONSHIPS.RELATIONSHIP_CODE(+)='CONTACT_OF' AND\r\n  HZ_RELATIONSHIPS.SUBJECT_ID = HZ_PARTIES.PARTY_ID(+) AND\r\n  HZ_RELATIONSHIPS.PARTY_ID = PARTY_REL.PARTY_ID(+) AND\r\n (CEBV_BANK_ACCOUNTS.LAST_UPDATE_DATE >TO_DATE('$$LAST_EXTRACT_DATE', 'MM/DD/YYYY HH24:MI:SS')  OR   \r\n  CEBV_BANK_BRANCHES.LAST_UPDATE_DATE >TO_DATE('$$LAST_EXTRACT_DATE', 'MM/DD/YYYY HH24:MI:SS'))"
      },
      "group_conditions": [],
      "port_expressions": [],
      "mapplet": "HHS_mplt_BC_ORA_BankDimension"
    },
