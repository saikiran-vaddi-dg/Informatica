      "attribute_value": "update ufms_bi.WC_PROGRAM_ACTIVITY_D set delete_flg='Y'\r\nwhere integration_id in\r\n(\r\nSELECT INTEGRATION_ID FROM UFMS_BI.WC_PROGRAM_ACTIVITY_D where ledger_wid<>2 and delete_flg='N'\r\nMINUS\r\nSELECT    TO_CHAR (h.PRC_HEADER_ID)\r\n       || '~'\r\n       || TO_CHAR (d.PRC_DETAIL_ID)\r\n       || '~'\r\n       || TO_CHAR (a.PRC_ALLOC_ID)\r\n  FROM FV.FV_FACTS_PRC_HDR@rhhs1i        h,\r\n       FV.FV_FACTS_PRC_DTL@rhhs1i        d,\r\n       FV.FV_DACT_PRC_ALLOCATION@rhhs1i  a\r\nWHERE     h.PRC_HEADER_ID = d.PRC_HEADER_ID\r\n       AND d.PRC_DETAIL_ID = a.PRC_DETAIL_ID\r\n       AND h.CODE_TYPE = 'R'\r\n)\r\nand row_wid<>0"
